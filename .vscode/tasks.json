{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "frontend:dev",
			"type": "shell",
			"isBackground": true,
			"command": "deno",
			"args": ["task", "dev"],
			"problemMatcher": {
				"pattern": { "regexp": "^(Error: .*)$", "message": 1 },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Task dev",
					"endsPattern": "VITE .*ready in"
				}
			}
		},
		{
			"label": "frontend:build",
			"type": "shell",
			"command": "deno",
			"args": ["task", "build"]
		}
	]
}
